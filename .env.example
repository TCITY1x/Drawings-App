# Leave the Supabase pair unset to run SitePax on this device only (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email for sending markups and packages (https://resend.com). Unset = download instead.
RESEND_API_KEY=
SITEPAX_FROM_EMAIL="SitePax <noreply@example.com>"

# Billing (https://stripe.com). Server-only, except the price label. Unset = no billing section actions.
# The service-role (secret) key lets the webhook write plan and seats past row-level security.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
# The recurring per-seat price (Product catalogue → the price's id, price_…).
STRIPE_PRICE_ID=
# From the webhook endpoint pointed at <site>/api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns people to; defaults to the address the request came to.
SITEPAX_SITE_URL=
# Shown on the Team page, e.g. "A$25 per user per month".
NEXT_PUBLIC_SITEPAX_PRICE_LABEL=
