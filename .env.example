# Leave the Supabase pair unset to run FieldMark on this device only (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email for sending markups and packages (https://resend.com). Unset = download instead.
RESEND_API_KEY=
FIELDMARK_FROM_EMAIL="FieldMark <noreply@example.com>"
