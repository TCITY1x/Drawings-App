# Leave the Supabase pair unset to run SitePax on this device only (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email for sending markups and packages (https://resend.com). Unset = download instead.
RESEND_API_KEY=
SITEPAX_FROM_EMAIL="SitePax <noreply@example.com>"

# Billing (https://stripe.com). Leave unset until Stripe is set up.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The recurring per-seat Price for the Team plan, e.g. price_123.
STRIPE_PRICE_ID=
# Shown on the landing page and the billing card, e.g. "A$29 per user / month".
NEXT_PUBLIC_SITEPAX_PRICE=
# Where Stripe returns people to; defaults to the request's own origin.
SITEPAX_SITE_URL=
